{
  "uid": "soup",
  "title": "Soup — очередь задач",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Запросов в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(soup_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(soup_http_duration_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(soup_http_duration_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ошибки, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "100*sum(rate(soup_http_requests_total{status=~\"5..\"}[1m]))/clamp_min(sum(rate(soup_http_requests_total[1m])),0.01)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Состояния заданий",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "soup_jobs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Завершений в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "deriv(soup_jobs{state=\"succeeded\"}[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Очередь RabbitMQ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"soup.jobs\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Outbox",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "soup_outbox_backlog",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Повторные попытки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(soup_retries_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Повторные доставки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(rabbitmq_channel_messages_redelivered_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Доступность БД",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "soup_postgres_available",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Доступность RabbitMQ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"rabbitmq\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Память процессов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "CPU процессов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Неподтверждённые сообщения",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_unacked{queue=\"soup.jobs\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Потребители",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_consumers{queue=\"soup.jobs\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "Возраст очереди",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "soup_oldest_job_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "Просроченные аренды",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "soup_expired_leases",
          "refId": "A"
        }
      ]
    }
  ]
}